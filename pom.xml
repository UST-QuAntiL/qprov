<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.quantil</groupId>
    <artifactId>qprov</artifactId>
    <packaging>pom</packaging>
    <version>1.5.0</version>
    <name>qprov</name>
    <description>Provenance System for Quantum Computing</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>25</java.version>
        <!-- JDK 23+ no longer runs annotation processors (Lombok) from the classpath by default -->
        <maven.compiler.proc>full</maven.compiler.proc>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.checkstyle.version>3.1.1</maven.checkstyle.version>
        <springdoc.version>3.1.1</springdoc.version>
        <prov.toolbox.version>2.0.3</prov.toolbox.version>
    </properties>

    <modules>
        <module>org.quantil.qprov.core</module>
        <module>org.quantil.qprov.web</module>
        <module>org.quantil.qprov.collector</module>
    </modules>
</project>
